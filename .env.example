NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
API_INTERNAL_URL=http://host.docker.internal:4000/api/v1
NEXT_PUBLIC_DEFAULT_TIME_ZONE=Asia/Bangkok
NEXT_PUBLIC_GOOGLE_CLIENT_ID=replace-with-google-oauth-web-client-id
NEXT_PUBLIC_MAP_PROVIDER=maplibre
NEXT_PUBLIC_MAP_STYLE_URL=https://demotiles.maplibre.org/style.json
NEXT_PUBLIC_MAP_DEFAULT_LAT=16.0471
NEXT_PUBLIC_MAP_DEFAULT_LNG=108.2068
NEXT_PUBLIC_MAP_DEFAULT_ZOOM=5
NEXT_PUBLIC_OSM_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# Required in production. Development falls back to the public OSRM demo service with a warning.
NEXT_PUBLIC_OSRM_ROUTE_URL=http://localhost:5000/route/v1
NEXT_PUBLIC_OSRM_TIMEOUT_MS=10000
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=replace-with-google-maps-browser-api-key
NEXT_PUBLIC_GOOGLE_MAP_ID=
NEXT_PUBLIC_GOOGLE_MAPS_REGION=VN
NEXT_PUBLIC_GOOGLE_MAPS_LANGUAGE=
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=
NEXT_PUBLIC_NOMINATIM_SEARCH_URL=https://nominatim.openstreetmap.org/search
NEXT_PUBLIC_AUTH_ACCESS_COOKIE_NAME=tp_access_token
NEXT_PUBLIC_AUTH_REFRESH_COOKIE_NAME=tp_refresh_token
NEXT_PUBLIC_AUTH_CSRF_COOKIE_NAME=tp_csrf_token
